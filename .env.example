# ============================================
# Netfliz API - Environment Variables Template
# ============================================
# Copy this file to .env and configure your values
# Command: cp .env.example .env
# ============================================

# ==========================================
# SERVER CONFIGURATION
# ==========================================
SERVER_PORT=8080

# ==========================================
# DATABASE - PostgreSQL
# ==========================================
POSTGRES_DB=netfliz
POSTGRES_USER=netfliz
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_PORT=5432

# ==========================================
# CACHE - Redis
# ==========================================
REDIS_PASSWORD=your_secure_redis_password
REDIS_USERNAME=
REDIS_PORT=6379

# ==========================================
# SECURITY - JWT
# ==========================================
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=your_256_bit_secret_key_here_minimum_32_characters

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated patterns, e.g.: https://*.example.com,http://localhost:*
CORS_ALLOWED_ORIGINS=*

# ==========================================
# FIREBASE STORAGE (Optional)
# ==========================================
FIREBASE_STORAGE_BASE_URL=
FIREBASE_STORAGE_CONFIG_PATH=
FIREBASE_STORAGE_CONFIG_BASE64=
FIREBASE_STORAGE_BUCKET_NAME=

# ==========================================
# BACKBLAZE S3 STORAGE (Optional)
# ==========================================
BACKBLAZE_S3_ENDPOINT=
BACKBLAZE_S3_REGION=
BACKBLAZE_S3_ACCESS_KEY_ID=
BACKBLAZE_S3_SECRET_ACCESS_KEY=
BACKBLAZE_S3_BUCKET_NAME=
BACKBLAZE_S3_WORKER_SHARED_SECRET=

# ==========================================
# CDN (Optional)
# ==========================================
PROXY_CDN_URL=
